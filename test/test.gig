print("=== GIG test.gig loaded! ===")
print("GIG is working correctly.")

clear()
draw_rect(50, 50, 200, 100, 255, 0, 0)
draw_circle(300, 200, 80, 0, 255, 0)
draw_text(50, 300, "Press SPACE to exit")

local x = 0
while x < 500 do
    clear()
    draw_rect(50, 50, 200, 100, 255, 0, 0)
    draw_circle(300, 200, 80, 0, 255, 0)
    draw_text(50, 300, "Press SPACE to exit")
    draw_rect(x, 350, 30, 30, 255, 255, 0)
    update()
    
    if key_pressed("space") then
        print("Space pressed!")
        break
    end
    x = x + 5
end

print("Script finished")
