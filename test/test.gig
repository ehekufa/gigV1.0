print("GIG Game Demo")
print("Drawing colorful shapes and checking keys.")

clear()
draw_rect(50, 50, 150, 100, 255, 0, 0)
draw_circle(300, 200, 80, 0, 255, 0)
draw_text(50, 300, "Press SPACE to exit")

-- Простая анимация (движущийся жёлтый квадрат)
local x = 0
while x < 500 do
    -- Рисуем квадрат, предварительно очистив экран? 
    -- В этом примере мы перерисовываем всё каждый кадр, чтобы не оставлять следов.
    clear()
    draw_rect(50, 50, 150, 100, 255, 0, 0)
    draw_circle(300, 200, 80, 0, 255, 0)
    draw_text(50, 300, "Press SPACE to exit")
    draw_rect(x, 350, 30, 30, 255, 255, 0)
    update()

    -- Проверка клавиши (выход по пробелу)
    if key_pressed("space") then
        print("Space pressed, exiting loop.")
        break
    end

    x = x + 5
end

print("Script finished.")
