print("GIG Animation Demo")
print("Moving square on white background.")

clear()

-- Рисуем статичные фигуры
draw_rect(50, 50, 150, 100, 255, 0, 0)   -- красный
draw_circle(300, 200, 80, 0, 255, 0)     -- зелёный круг
draw_text(50, 300, "Press SPACE to exit")

-- Движущийся жёлтый квадрат
local x = 0
while x < 500 do
    -- Перерисовываем всё заново, чтобы квадрат не оставлял следов
    clear()
    draw_rect(50, 50, 150, 100, 255, 0, 0)
    draw_circle(300, 200, 80, 0, 255, 0)
    draw_text(50, 300, "Press SPACE to exit")
    draw_rect(x, 350, 30, 30, 255, 255, 0)  -- жёлтый квадрат
    update()

    if key_pressed("space") then
        print("Space pressed, exiting loop.")
        break
    end

    x = x + 5
end

print("Script finished.")
