print("Hello from test.gig!")
print("ccccccc")

function fact(n)
    if n == 0 then return 1 end
    return n * fact(n - 1)
end

local result = fact(5)
print("fact(5) =", result)

function fib(n)
    if n <= 1 then return n end
    return fib(n - 1) + fib(n - 2)
end

print("fib(10) =", fib(10))

local x = 10
local y = 20
if x < y then
    print("x < y")
else
    print("x >= y")
end

local i = 0
while i < 3 do
    print("i =", i)
    i = i + 1
end

