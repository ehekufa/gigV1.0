print("=== pcall test ===")

-- Функция, которая может выбросить ошибку
function divide(a, b)
    if b == 0 then
        error("division by zero!")   -- выбросить ошибку
    end
    return a / b
end

-- Успешный вызов
local ok, result = pcall(divide, 10, 2)
if ok then
    print("10 / 2 =", result)
else
    print("Error:", result)
end

-- Вызов с ошибкой
local ok2, err = pcall(divide, 10, 0)
if ok2 then
    print("10 / 0 =", err)
else
    print("Caught error:", err)
end

print("pcall test finished.")
